generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  username String  @unique
  password String
  name     String?
}

model News {
  id        String   @id @default(cuid())
  title     String
  excerpt   String
  content   String
  image     String
  date      DateTime @default(now())
  category  String
  author    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  src       String
  alt       String
  createdAt DateTime @default(now())
}
