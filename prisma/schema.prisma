generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  username String  @unique
  password String
  name     String?
}

model News {
  id          String        @id @default(cuid())
  title       String
  titleEn     String?
  excerpt     String
  excerptEn   String?
  content     String
  contentEn   String?
  image       String
  date        DateTime      @default(now())
  dateFa      String?
  categoryId  String?
  category    NewsCategory? @relation(fields: [categoryId], references: [id])
  author      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model NewsCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  nameFa    String
  news      News[]
  createdAt DateTime @default(now())
}

model GalleryCategory {
  id        String         @id @default(cuid())
  name      String         @unique
  nameFa    String?
  images    GalleryImage[]
  createdAt DateTime       @default(now())
}

model GalleryImage {
  id         String           @id @default(cuid())
  src        String
  alt        String
  categoryId String?
  category   GalleryCategory? @relation(fields: [categoryId], references: [id])
  createdAt  DateTime         @default(now())
}

model TimelinePeriod {
  id        String          @id @default(cuid())
  title     String
  titleEn   String?
  order     Int             @default(0)
  image     String?
  events    TimelineEvent[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model TimelineEvent {
  id            String         @id @default(cuid())
  title         String
  titleEn       String?
  description   String
  descriptionEn String?
  date          String?    // Usually Farsi date
  dateEn        String?    // English date
  image         String?
  periodId      String
  period        TimelinePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  order         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model ServiceSection {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  titleEn   String?
  summary   String
  summaryEn String?
  content   String
  contentEn String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
